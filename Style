:root {
    --cor-primaria: #fc9c01;
    --cor-secundaria: #eacc07;
    --cor-destaque: #e68a00;
    --cor-borda-card: #ff5e00;
    
    --cor-fundo: #f4f4f6;
    --cor-fundo-card: #ffffff;
    --cor-fundo-contador: #f1f1f1;
    
    --cor-texto: #555555;
    --cor-texto-claro: #ffffff;
    
    --fonte-principal: Arial, sans-serif;
    --fonte-botoes: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body.dark-theme {
    --cor-primaria: #1f2937;
    --cor-secundaria: #374151;
    --cor-destaque: #f59e0b;
    --cor-borda-card: #4b5563;
    
    --cor-fundo: #111827;
    --cor-fundo-card: #1f2937;
    --cor-fundo-contador: #374151;
    
    --cor-texto: #e5e7eb;
    --cor-texto-claro: #ffffff;
    
    --fonte-principal: 'Segoe UI', Roboto, sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--cor-fundo);
    font-family: var(--fonte-principal);
    color: var(--cor-texto);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: background-color 0.3s, color 0.3s;
}

header {
    background-color: var(--cor-primaria);
    color: var(--cor-texto-claro);
    width: 100%;
    max-width: 1100px;
    margin: 30px auto 20px;
    padding: 30px;
    text-align: center;
    border-bottom: 6px solid var(--cor-secundaria);
    border-radius: 0 0 10px 10px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    position: relative;
}

header h1 {
    font-size: 32px;
    margin-bottom: 8px;
}

.btn-tema {
    position: absolute;
    top: 15px;
    right: 15px;
    background-color: var(--cor-secundaria);
    color: var(--cor-texto);
    font-family: var(--fonte-botoes);
    border: none;
    padding: 8px 12px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 14px;
    font-weight: bold;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    transition: transform 0.2s;
}

.btn-tema:hover {
    transform: scale(1.05);
}

main {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
}

.inicio {
    width: 100%;
    background-color: var(--cor-fundo-card);
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 25px;
}

.icone {
    width: 120px;
    height: 80px;
    object-fit: contain;
}

.conteudo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

article {
    background-color: var(--cor-fundo-card);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;

    border: 1px solid var(--cor-borda-card);
    border-radius: 8px;
    padding: 16px;

    flex: 1 1 calc(33.333% - 16px);
    min-width: 280px;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
}

h2 {
    color: var(--cor-destaque);
    font-size: 22px;
}

p {
    font-size: 15px;
    line-height: 1.6;
}

ol {
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
}

.reacoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
}

button {
    font-family: var(--fonte-botoes);
    border: none;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
}

.like {
    background-color: var(--cor-destaque);
    color: var(--cor-texto-claro);
    border: 2px solid var(--cor-secundaria);
}

.dislike {
    background-color: var(--cor-fundo-contador);
    color: var(--cor-texto);
}

.contador {
    background-color: var(--cor-fundo-contador);
    color: var(--cor-texto);
    cursor: default;
}

.ativo {
    background-color: var(--cor-secundaria);
    color: #000;
}

footer {
    background-color: var(--cor-primaria);
    color: var(--cor-texto-claro);
    width: 100%;
    max-width: 1100px;
    margin: 25px auto;
    padding: 20px;
    text-align: center;
    border-top: 5px solid var(--cor-secundaria);
}

@media (max-width: 900px) {
    article {
        flex: 1 1 calc(50% - 16px);
    }
}

@media (max-width: 600px) {
    article {
        flex: 1 1 100%;
    }

    .inicio {
        flex-direction: column;
        align-items: flex-start;
    }
}