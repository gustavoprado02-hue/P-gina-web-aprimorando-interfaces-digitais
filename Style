  * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f4f4f6;
            font-family: Arial, sans-serif;
            color: #555;
        }

        header {
            background-color: #fc9c01;
            color: white;
            max-width: 850px;
            margin: 30px auto 20px;
            padding: 30px;
            text-align: center;
            border-bottom: 6px solid #eacc07;
            border-radius: 0 0 10px 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        header h1 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        main {
            background-color: white;
            max-width: 850px;
            margin: auto;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .inicio {
            display: flex;
            gap: 25px;
            padding-bottom: 25px;
            border-bottom: 1px solid #ddd;
        }

        .icone {
            width: 120px;
            height: 80px;
            object-fit: contain;
        }

        .conteudo {
            flex: 1;
        }

        section {
            padding: 35px 0;
            border-bottom: 1px solid #ddd;
        }

        section:last-child {
            border-bottom: none;
        }

        h2 {
            color: #e68a00;
            font-size: 28px;
            margin-bottom: 15px;
        }

        p {
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 12px;
        }

        ol {
            padding-left: 40px;
            margin-top: 20px;
        }

        li {
            padding: 8px 0;
            line-height: 1.6;
        }

        .reacoes {
            display: flex;
            gap: 10px;
            margin-top: 18px;
        }

        button {
            border: none;
            padding: 12px 16px;
            font-size: 15px;
            font-weight: bold;
            border-radius: 7px;
            cursor: pointer;
        }

        .like {
            background-color: #c97b00;
            color: white;
            border: 2px solid #eacc07;
        }

        .dislike {
            background-color: #e9ecef;
            color: #555;
        }

        .contador {
            background-color: #f1f1f1;
            color: #555;
        }

        .ativo {
            background-color: #e68a00;
            color: white;
        }

        footer {
            background-color: #fc9c01;
            color: white;
            max-width: 850px;
            margin: 25px auto;
            padding: 20px;
            text-align: center;
            border-top: 5px solid #eacc07;
        }
        @media (max-width: 600px) {

            header, main, footer {
                margin-left: 15px;
                margin-right: 15px;
            }

            main {
                padding: 20px;
            }

            .inicio {
                gap: 15px;
            }

            .icone {
                width: 100px;
                height: 70px;
            }

            h2 {
                font-size: 22px;
            }

        }