head
    meta charset=<"UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>World Fut</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #f4f4f6;
            font-family: Arial, sans-serif;
            color: #555;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        header {
            background-color: #fc9c01;
            color: white;
            width: 100%;
            max-width: 1100px;
            margin: 30px auto 20px;
            padding: 30px;
            text-align: center;
            border-bottom: 6px solid #eacc07;
            border-radius: 0 0 10px 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        header h1 {
            font-size: 32px;
            margin-bottom: 8px;
        }

        main {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 16px;

            display: flex;
            flex-wrap: wrap;
            gap: 16px;
        }

        .inicio {
            width: 100%;
            background-color: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .icone {
            width: 120px;
            height: 80px;
            object-fit: contain;
        }

        .conteudo {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        article {
            background-color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 16px;

            border: 1px solid #183C63;
            border-radius: 8px;
            padding: 16px;


            flex: 1 1 calc(33.333% - 16px);
            min-width: 280px;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
        }

        h2 {
            color: #e68a00;
            font-size: 22px;
        }

        p {
            font-size: 15px;
            line-height: 1.6;
        }

        ol {
            padding-left: 20px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 14px;
        }

    
        .reacoes {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-top: auto;
            padding-top: 10px;
            border-top: 1px solid #eee;
        }

        button {
            border: none;
            padding: 8px 12px;
            font-size: 13px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
        }

        .like {
            background-color: #c97b00;
            color: white;
            border: 2px solid #eacc07;
        }

        .dislike {
            background-color: #e9ecef;
            color: #555;
        }

        .contador {
            background-color: #f1f1f1;
            color: #555;
            cursor: default;
        }

        .ativo {
            background-color: #e68a00;
            color: white;
        }

        footer {
            background-color: #fc9c01;
            color: white;
            width: 100%;
            max-width: 1100px;
            margin: 25px auto;
            padding: 20px;
            text-align: center;
            border-top: 5px solid #eacc07;
        }

    
        @media (max-width: 900px) {
            article {
                flex: 1 1 calc(50% - 16px); 
            }
        }

        @media (max-width: 600px) {
            article {
                flex: 1 1 100%;
            }

            .inicio {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>